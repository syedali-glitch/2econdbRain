<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/thoughtCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:strokeWidth="1.5dp"
    app:strokeColor="@color/card_stroke"
    app:rippleColor="@color/ripple_color">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header: Category dot + Date + Pin indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="4dp">

            <!-- Category Color Dot - Larger and more vibrant -->
            <View
                android:id="@+id/categoryDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/circle_shape"/>

            <!-- Category Text -->
            <TextView
                android:id="@+id/categoryTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:text="Decision"/>

            <!-- Pin Indicator - More prominent -->
            <TextView
                android:id="@+id/pinnedIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pinned"
                android:textColor="@color/primary_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/rounded_bg"
                android:visibility="gone"/>

            <!-- Date -->
            <TextView
                android:id="@+id/dateTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/text_tertiary"
                android:textSize="13sp"
                android:text="Today"/>

        </LinearLayout>

        <!-- Title (if exists) - Larger and bolder -->
        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/text_off_white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:letterSpacing="0.01"
            android:ellipsize="end"
            android:visibility="gone"/>

        <!-- Main Thought Text with better readability -->
        <TextView
            android:id="@+id/thoughtTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.5"
            android:maxLines="3"
            android:ellipsize="end"
            android:alpha="0.95"
            android:text="This is a sample thought that might be longer..."/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

