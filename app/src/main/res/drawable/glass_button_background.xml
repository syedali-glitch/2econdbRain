<?xml version="1.0" encoding="utf-8"?>
<!-- Glass Button Background with blur effect -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background with gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#4D8B5CF6"
                android:endColor="#4D06B6D4"
                android:type="linear" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    
    <!-- Glass overlay -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_overlay" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    
    <!-- Border -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="#80FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
